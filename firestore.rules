rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isChatParticipant() {
      return isSignedIn()
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants;
    }

    function isChatOwnerOrRenter() {
      return isSignedIn()
        && (
          resource.data.ownerId == request.auth.uid
          || resource.data.renterId == request.auth.uid
        );
    }

    function isChatParticipantOnCreate() {
      return isSignedIn()
        && request.resource.data.participants is list
        && request.auth.uid in request.resource.data.participants;
    }

    function isChatOwnerOrRenterOnCreate() {
      return isSignedIn()
        && (
          request.resource.data.ownerId == request.auth.uid
          || request.resource.data.renterId == request.auth.uid
        );
    }

    function canAccessMessages(chatRoomId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/chat_rooms/$(chatRoomId))
        && (
          (
            get(/databases/$(database)/documents/chat_rooms/$(chatRoomId)).data.participants is list
            && request.auth.uid in get(/databases/$(database)/documents/chat_rooms/$(chatRoomId)).data.participants
          )
          || get(/databases/$(database)/documents/chat_rooms/$(chatRoomId)).data.ownerId == request.auth.uid
          || get(/databases/$(database)/documents/chat_rooms/$(chatRoomId)).data.renterId == request.auth.uid
        );
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || isOwner(userId);
      allow update: if isAdmin() || isOwner(userId);
      allow delete: if isAdmin();

      match /favorites/{favoriteId} {
        allow read, write: if isAdmin() || isOwner(userId);
      }
    }

    match /rentals/{rentalId} {
      allow read: if isSignedIn();
      allow create: if isAdmin()
        || (
          isSignedIn()
          && (
            request.resource.data.ownerId == request.auth.uid
            || request.resource.data.hostId == request.auth.uid
          )
        );
      allow update, delete: if isAdmin()
        || (
          isSignedIn()
          && (
            resource.data.ownerId == request.auth.uid
            || resource.data.hostId == request.auth.uid
          )
        );
    }

    match /transactions/{transactionId} {
      allow read: if isAdmin()
        || (
          isSignedIn()
          && (
            resource.data.renterId == request.auth.uid
            || resource.data.hostId == request.auth.uid
          )
        );
      allow create: if isAdmin()
        || (
          isSignedIn()
          && request.resource.data.renterId == request.auth.uid
        );
      allow update: if isAdmin()
        || (
          isSignedIn()
          && (
            resource.data.renterId == request.auth.uid
            || resource.data.hostId == request.auth.uid
          )
        );
      allow delete: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /chat_rooms/{chatRoomId} {
      allow read: if isAdmin() || isChatParticipant() || isChatOwnerOrRenter();
      allow create: if isAdmin()
        || isChatParticipantOnCreate()
        || isChatOwnerOrRenterOnCreate();
      allow update: if isAdmin()
        || isChatParticipant()
        || isChatOwnerOrRenter();
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read, create, update: if isAdmin() || canAccessMessages(chatRoomId);
        allow delete: if isAdmin();
      }
    }

    match /reports/{reportId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /flagged_items/{reportId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /moderation_reports/{reportId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
